---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sirgrimorum — Building tools for thinkers and builders',
  description = 'Sirgrimorum — building AI tools for thinkers and builders. Cerebro Externo, Forge Mentor, Entrepreneurity.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Silkscreen:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-darkest: #0d0d14;
    --bg-surface: #1e1812;
    --brass-primary: #c9a84c;
    --brass-bright: #d4a017;
    --text-heading: #f5e6c8;
    --text-primary: #ccaa66;
    --text-muted: #8a8a96;
    --copper: #b87333;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg-darkest);
    color: var(--text-primary);
    font-family: 'IBM Plex Mono', monospace;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem;
  }

  /* Disable anti-aliasing on pixel fonts */
  .pixel-font {
    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: unset;
  }

  /* Preserve pixelation on scaled pixel art images */
  .pixel-art {
    image-rendering: pixelated;
  }
</style>
