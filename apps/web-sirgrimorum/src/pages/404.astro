---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Sirgrimorum" description="Page not found.">
  <main>
    <header class="hero">
      <img src="/dragon-seal.png" class="hero-seal pixel-art" width="148" height="148" alt="Sirgrimorum dragon seal" />
      <h1 class="title pixel-font">404</h1>
      <p class="tagline">This page was lost in the steam.</p>
      <a href="/" class="home-link">Back to the workshop</a>
    </header>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero {
    text-align: center;
    padding: 6rem 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-seal {
    width: 148px;
    height: 148px;
    filter: drop-shadow(0 0 14px color-mix(in srgb, #c9a84c 40%, transparent));
    opacity: 0.6;
  }

  .title {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(2rem, 8vw, 3rem);
    color: var(--text-heading);
    text-shadow: 0 0 20px color-mix(in srgb, var(--brass-primary) 50%, transparent);
    letter-spacing: 0.1em;
  }

  .tagline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .home-link {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-heading);
    text-decoration: none;
    background:
      radial-gradient(circle,
        color-mix(in srgb, var(--brass-primary) 50%, white) 0px,
        var(--brass-primary) 2px,
        color-mix(in srgb, var(--brass-primary) 40%, black) 3px,
        transparent 3.5px
      ) 8px 50% / 7px 7px no-repeat,
      radial-gradient(circle,
        color-mix(in srgb, var(--brass-primary) 50%, white) 0px,
        var(--brass-primary) 2px,
        color-mix(in srgb, var(--brass-primary) 40%, black) 3px,
        transparent 3.5px
      ) calc(100% - 8px) 50% / 7px 7px no-repeat,
      var(--bg-surface);
    padding: 0.625rem 2.25rem;
    border: 2px solid;
    border-top-color: color-mix(in srgb, var(--brass-primary) 55%, white);
    border-left-color: color-mix(in srgb, var(--brass-primary) 45%, white);
    border-right-color: color-mix(in srgb, var(--brass-primary) 60%, black);
    border-bottom-color: color-mix(in srgb, var(--brass-primary) 70%, black);
    border-radius: 4px;
    box-shadow:
      0 3px 6px rgba(0, 0, 0, 0.5),
      0 1px 2px rgba(0, 0, 0, 0.3),
      inset 0 1px 2px color-mix(in srgb, var(--brass-primary) 25%, white),
      inset 0 -2px 3px rgba(0, 0, 0, 0.5);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .home-link:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 14px rgba(0, 0, 0, 0.6),
      0 2px 4px rgba(0, 0, 0, 0.4),
      0 0 10px color-mix(in srgb, var(--brass-primary) 25%, transparent),
      inset 0 1px 2px color-mix(in srgb, var(--brass-primary) 30%, white),
      inset 0 -2px 3px rgba(0, 0, 0, 0.5);
  }

  .home-link:active {
    transform: translateY(1px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.5),
      inset 0 2px 4px rgba(0, 0, 0, 0.6),
      inset 0 -1px 1px color-mix(in srgb, var(--brass-primary) 20%, white);
  }
</style>
