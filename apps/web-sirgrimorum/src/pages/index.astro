---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'Cerebro Externo',
    tagline: 'Your AI external brain.',
    description:
      'Extracts your expertise through conversations and organizes it as a library your AI always has at hand.',
    status: 'alpha' as const,
    url: 'https://brain4ai.app',
    accent: '#5a9abe',
  },
  {
    name: 'Forge Mentor',
    tagline: 'AI mentor for startup builders.',
    description:
      'An AI mentor forged from 10+ years of startup acceleration that tells you what to do today, not another framework.',
    status: 'alpha' as const,
    url: 'https://mentor4ai.app',
    accent: '#e8a317',
  },
  {
    name: 'Entrepreneurity',
    tagline: 'Learn business strategy by playing.',
    description:
      'A steampunk strategy game where you build and operate a business in living markets. Design experiments, face market waves, analyze results, adapt or die.',
    status: 'coming-soon' as const,
    url: 'https://entrepreneurity.app',
    accent: '#c0392b',
  },
] satisfies Parameters<typeof ProjectCard>[0][];
---

<Layout>
  <main>
    <header class="hero">
      <div class="gear-icon pixel-font" aria-hidden="true">⚙</div>
      <h1 class="hero-title pixel-font">SIRGRIMORUM</h1>
      <p class="hero-tagline">Building tools for thinkers<br />and builders.</p>
    </header>

    <section class="projects" aria-label="Projects">
      {projects.map((project) => <ProjectCard {...project} />)}
    </section>

    <footer>
      <p>© 2026 sirgrimorum</p>
    </footer>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero {
    text-align: center;
    padding: 3rem 0 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .gear-icon {
    font-size: 2.5rem;
    color: var(--brass-primary);
    line-height: 1;
  }

  .hero-title {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(1rem, 4vw, 1.5rem);
    color: var(--text-heading);
    text-shadow: 0 0 20px color-mix(in srgb, var(--brass-primary) 50%, transparent);
    letter-spacing: 0.1em;
  }

  .hero-tagline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  footer {
    text-align: center;
    padding-bottom: 2rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
