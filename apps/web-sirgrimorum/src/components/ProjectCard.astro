---
interface Props {
  name: string;
  tagline: string;
  description: string;
  status: 'alpha' | 'coming-soon';
  badgeText: string;
  url: string;
  accent: string;
}

const { name, tagline, description, badgeText, url, accent } = Astro.props;
const displayUrl = url.replace('https://', '');
---

<a href={url} class="card" style={`--accent: ${accent}`} target="_blank" rel="noopener noreferrer">
  <div class="card-header">
    <span class="card-name">{name}</span>
    <span class="badge">{badgeText}</span>
  </div>
  <p class="card-tagline">{tagline}</p>
  <p class="card-description">{description}</p>
  <span class="card-link">{displayUrl} →</span>
</a>

<style>
  .card {
    display: block;
    /* Base surface + 4 corner rivets as radial-gradient dots */
    background:
      radial-gradient(circle, var(--accent) 4px, transparent 4px) 8px 8px / 8px 8px no-repeat,
      radial-gradient(circle, var(--accent) 4px, transparent 4px) calc(100% - 8px) 8px / 8px 8px no-repeat,
      radial-gradient(circle, var(--accent) 4px, transparent 4px) 8px calc(100% - 8px) / 8px 8px no-repeat,
      radial-gradient(circle, var(--accent) 4px, transparent 4px) calc(100% - 8px) calc(100% - 8px) / 8px 8px no-repeat,
      var(--bg-surface);
    border: 2px solid var(--accent);
    border-radius: 8px;
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 20%, transparent);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease;
  }

  .card:hover {
    box-shadow: 0 0 20px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .card-name {
    font-family: 'Silkscreen', monospace;
    font-size: 1rem;
    color: var(--accent);
    text-shadow: 0 0 8px color-mix(in srgb, var(--accent) 55%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: var(--text-muted);
    border: 1px solid var(--text-muted);
    padding: 0.125rem 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card-tagline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .card-description {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .card-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--copper);
  }
</style>
