---
interface Props {
  name: string;
  tagline: string;
  description: string;
  status: 'alpha' | 'coming-soon';
  badgeText: string;
  url: string;
  accent: string;
}

const { name, tagline, description, badgeText, url, accent } = Astro.props;
const displayUrl = url.replace('https://', '');
---

<a href={url} class="card" style={`--accent: ${accent}`} target="_blank" rel="noopener noreferrer">
  <div class="card-header">
    <span class="card-name">{name}</span>
    <span class="badge">{badgeText}</span>
  </div>
  <p class="card-tagline">{tagline}</p>
  <p class="card-description">{description}</p>
  <span class="card-link">{displayUrl} →</span>
</a>

<style>
  .card {
    display: block;
    /* Base surface + 4 corner rivets as 3D rounded nail heads */
    background:
      radial-gradient(circle,
        color-mix(in srgb, var(--accent) 50%, white) 0px,
        var(--accent) 2.5px,
        color-mix(in srgb, var(--accent) 40%, black) 4px,
        transparent 5px
      ) 10px 10px / 10px 10px no-repeat,
      radial-gradient(circle,
        color-mix(in srgb, var(--accent) 50%, white) 0px,
        var(--accent) 2.5px,
        color-mix(in srgb, var(--accent) 40%, black) 4px,
        transparent 5px
      ) calc(100% - 10px) 10px / 10px 10px no-repeat,
      radial-gradient(circle,
        color-mix(in srgb, var(--accent) 50%, white) 0px,
        var(--accent) 2.5px,
        color-mix(in srgb, var(--accent) 40%, black) 4px,
        transparent 5px
      ) 10px calc(100% - 10px) / 10px 10px no-repeat,
      radial-gradient(circle,
        color-mix(in srgb, var(--accent) 50%, white) 0px,
        var(--accent) 2.5px,
        color-mix(in srgb, var(--accent) 40%, black) 4px,
        transparent 5px
      ) calc(100% - 10px) calc(100% - 10px) / 10px 10px no-repeat,
      var(--bg-surface);
    border: 2px solid;
    border-top-color: color-mix(in srgb, var(--accent) 55%, white);
    border-left-color: color-mix(in srgb, var(--accent) 45%, white);
    border-right-color: color-mix(in srgb, var(--accent) 60%, black);
    border-bottom-color: color-mix(in srgb, var(--accent) 70%, black);
    border-radius: 6px;
    box-shadow:
      0 4px 8px rgba(0, 0, 0, 0.5),
      0 1px 3px rgba(0, 0, 0, 0.3),
      inset 0 1px 2px color-mix(in srgb, var(--accent) 25%, white),
      inset 0 -2px 4px rgba(0, 0, 0, 0.5);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.6),
      0 2px 6px rgba(0, 0, 0, 0.4),
      0 0 14px color-mix(in srgb, var(--accent) 30%, transparent),
      inset 0 1px 3px color-mix(in srgb, var(--accent) 35%, white),
      inset 0 -2px 4px rgba(0, 0, 0, 0.5);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .card-name {
    font-family: 'Silkscreen', monospace;
    font-size: 1rem;
    color: var(--accent);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: var(--text-muted);
    border: 1px solid var(--text-muted);
    padding: 0.125rem 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card-tagline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .card-description {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .card-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--copper);
  }
</style>
